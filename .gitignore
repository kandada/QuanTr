# ── OS / IDE ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
/src/*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/
.coverage
htmlcov/

# ── Secrets / local env ──────────────────────────────────
.env
.env.*
!.env.example

# ── Packaging artifacts ──────────────────────────────────
/dist/
/build/

# ── Local market data / outputs (NEVER commit) ───────────
/store/
/examples/workspace/store/
/examples/workspace/data_files/
/examples/workspace/logs/
/examples/workspace/.aacode/
*.log

# Dated analysis outputs, but keep the templates contract
/examples/workspace/analysis_results/*/
!/examples/workspace/analysis_results/templates/

# Generated backtest reports / structure maps
/examples/workspace/backtest_reports/*.md
/examples/workspace/project_structure.md
