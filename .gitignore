# ── OS / IDE ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
/src/*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/
.coverage
htmlcov/

# ── Secrets / local env ──────────────────────────────────
.env
.env.*
!.env.example

# ── Packaging artifacts ──────────────────────────────────
/dist/
/build/

# ── Legacy vendored copy (kept only in the local dev workspace) ──
/_legacy_vendored_1.7.7/

# ── Local market data / outputs (NEVER commit) ───────────
/store/
/quan_tr/store/
/quan_tr/data_files/
/quan_tr/logs/
/quan_tr/.aacode/
*.log

# Dated analysis outputs, but keep the templates contract
/quan_tr/analysis_results/*/
!/quan_tr/analysis_results/templates/

# Generated backtest reports / structure maps
/quan_tr/backtest_reports/*.md
/quan_tr/project_structure.md
